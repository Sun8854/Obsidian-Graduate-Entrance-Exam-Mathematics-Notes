{
	"nodes":[
		{"id":"c210d67c14c2e723","type":"group","x":-580,"y":-120,"width":340,"height":426,"label":"方程组的解"},
		{"id":"cd644dc9298ad930","type":"group","x":-140,"y":-120,"width":460,"height":240,"label":"线性关系"},
		{"id":"f6044a81fe3dd5a9","type":"group","x":-110,"y":-420,"width":280,"height":200,"label":"方阵"},
		{"id":"2c19420546fb99b3","type":"group","x":-266,"y":500,"width":182,"height":208,"label":"等价"},
		{"id":"18fe51890c70148a","type":"text","text":"<center>向量组中含有 0 向量或有成比例的向量</center>","x":-18,"y":260,"width":188,"height":91},
		{"id":"5a7711e85f731797","type":"text","text":"<center>至少有一个向量可由其余向量线性表示</center>","x":200,"y":200,"width":200,"height":66},
		{"id":"20e441d438842246","type":"text","text":"齐次方程组只有零解\n(AX=0, A 为列向量组)","x":-539,"y":-80,"width":250,"height":60},
		{"id":"ddcb45048ba48665","type":"text","text":"<center>列不满秩</center>","x":-740,"y":-300,"width":116,"height":60,"color":"2"},
		{"id":"638752ca1879cc13","type":"text","text":"$r(A)=r([A,\\beta])$","x":-773,"y":110,"width":149,"height":60,"color":"2"},
		{"id":"722eb99ebceaf370","type":"text","text":"$r([A,\\beta]) = r(A) + 1$","x":-797,"y":206,"width":173,"height":60,"color":"2"},
		{
			"id":"6ef44bd0697acba7",
			"type":"text",
			"text":"<center>列向量组线性相关</center>",
			"styleAttributes":{"textAlign":"center"},
			"x":-80,
			"y":20,
			"width":250,
			"height":60
		},
		{
			"id":"d77851a6184f3ec3",
			"type":"text",
			"text":"<center>列向量组线性无关</center>",
			"styleAttributes":{"textAlign":"center"},
			"x":-80,
			"y":-80,
			"width":250,
			"height":60
		},
		{"id":"6a2d75a351840019","type":"text","text":"<center>方阵且|A|=0</center>","x":-40,"y":-400,"width":138,"height":60},
		{"id":"5c4ed28dc875c0e0","type":"text","text":"方阵且|A| $\\neq$ 0","x":-40,"y":-300,"width":160,"height":60},
		{"id":"a4c00ae50ffbdc3a","type":"text","text":"<center>矩阵可逆</center>","x":250,"y":-300,"width":125,"height":60},
		{"id":"a32bd20710402451","type":"text","text":"非齐次方程组无解\n(AX= $\\beta$ )","x":-539,"y":206,"width":250,"height":60},
		{"id":"4e4ad2cee02668dd","type":"text","text":"齐次方程组有非零解\n(AX=0, A 为列向量组)","x":-539,"y":20,"width":250,"height":60},
		{"id":"601bbdf785b9395c","type":"text","text":"非齐次方程组有解\n(AX=$\\beta$  )","x":-539,"y":110,"width":250,"height":60},
		{"id":"97240d3f59f6bc8f","type":"text","text":"<center>列满秩矩阵</center>","x":-487,"y":-300,"width":145,"height":60,"color":"2"},
		{"id":"c86f6334361f98d8","type":"text","text":"胖矩阵","x":-140,"y":200,"width":96,"height":60},
		{"id":"a63a051de5e8fc23","type":"text","text":"<center>任一部分向量组线性无关</center>","x":313,"y":-200,"width":250,"height":60},
		{"id":"0413a3720b7f2dae","type":"text","text":"三秩相等：$r(S_1)=r(S_2)=r(S_1,S_2)$","x":-4,"y":620,"width":291,"height":75},
		{"id":"14c06b3c389c55fa","type":"text","text":"<center>等价向量组</center>","x":-246,"y":628,"width":142,"height":60},
		{"id":"be3395b404de826a","type":"text","text":"<center>两个同维向量组可以相互表示</center>","x":-539,"y":628,"width":192,"height":60},
		{"id":"821b8a92e510f2d7","type":"text","text":"$S_1\\text{ 可由 }S_2\\text{ 表示}$ 且 $r(S_1)=r(S_2)$","x":-316,"y":781,"width":283,"height":60},
		{"id":"50fd62276978fabc","type":"text","text":"<center>矩阵等价</center>","x":-236,"y":520,"width":123,"height":60},
		{"id":"c922a7e8499208aa","type":"text","text":"两矩阵同型且 $r(A)=r(B)$","x":-4,"y":520,"width":250,"height":60},
		{"id":"b282d6ca85f91e3f","type":"text","text":"<center>任一向量均不能由其余向量线性表示</center>","x":375,"y":-80,"width":250,"height":60},
		{"id":"f76c89722dab7840","type":"text","text":"<center>判别线性相关性的七大定理</center>","x":200,"y":-10,"width":100,"height":120},
		{"id":"5581cf486ccd6e02","type":"text","text":"<center>初等行变换</center>","x":-797,"y":440,"width":140,"height":60},
		{"id":"4b3345ed2359ea9b","type":"text","text":"<center>变换前后行向量组</center>","x":-568,"y":490,"width":111,"height":60},
		{"id":"bcf57d738a4c421f","type":"text","text":"<center>变换前后相应部分列向量组</center>","x":-425,"y":380,"width":156,"height":60},
		{"id":"eac1b8e1160abef1","type":"text","text":"<center>极大无关组</center>","x":400,"y":321,"width":134,"height":60}
	],
